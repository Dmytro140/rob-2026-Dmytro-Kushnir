from ev3dev2.motor import MoveTank, OUTPUT_A, OUTPUT_B
from ev3dev2.sensor.lego import UltrasonicSensor
from ev3dev2.sensor import INPUT_2
from time import sleep


tank_drive = MoveTank(OUTPUT_A, OUTPUT_B)
ultra = UltrasonicSensor(INPUT_2)


def drive_to_obstacle(threshold):
    print("Старт! Цільова відстань:", threshold, "см")
    MAX_SPEED = 60
    MIN_SPEED = 5 
    Kp = 2 
    
    while True:
        current_distance = ultra.distance_centimeters
        error = current_distance - threshold
        
        if error <= 0:
            break
        speed = error * Kp
        
        if speed > MAX_SPEED:
            speed = MAX_SPEED
        elif speed < MIN_SPEED:
            speed = MIN_SPEED
            
        tank_drive.on(speed, speed)
        sleep(0.01)
        
    tank_drive.off()
    print("Зупинка! Фактична відстань:", ultra.distance_centimeters, "см\n")


drive_to_obstacle(25)

sleep(1) 

drive_to_obstacle(10)

